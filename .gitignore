# photos uploaded through the Add/Edit Product form
# (only the sample photos and their credits are kept in the repo)
product/images/*
!product/images/sample_*.jpg
!product/images/CREDITS.txt

# emails saved by MAIL_DRIVER 'log' (they contain password reset links)
storage/mail/*
!storage/mail/.gitkeep

# profile photos uploaded by users
user/images/*
!user/images/.gitkeep

# Mailtrap username and password (copy includes/mail_config.example.php)
includes/mail_config.php
